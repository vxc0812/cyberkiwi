# Server-side only. Never prefix with VITE_ and never commit a real key.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# NVD CVE API key (optional, server-side only; the ingestion worker sends it as an apiKey header).
# Request one from https://nvd.nist.gov/developers/request-an-api-key. Without it NVD rate-limits heavily.
NVD_API_KEY=

# AI routes (/api/gemini/*) are disabled unless this is set. Use a random value of at least 32 characters.
# The desktop app creates its own per-launch token; set this only for a server you run yourself.
# AI_ACCESS_TOKEN=

# Daily AI limits (UTC day). Counts are kept in PostgreSQL, so they survive restarts and hold across replicas.
# AI_DAILY_LIMIT=1000            desktop app token
# AI_PLATFORM_DAILY_LIMIT=1000   all calls that spend the server's GEMINI_API_KEY
# AI_USER_DAILY_LIMIT=100        per signed-in user (spends the server key)
# AI_BYOK_DAILY_LIMIT=500        per user-supplied key (spends nothing on the server key)

# Server port (default 3000)
PORT=3000

# Exact origins allowed to make credentialed (cookie) requests in production, comma-separated.
# No wildcards. Native apps need their own origins: capacitor://localhost (iOS) and https://localhost (Android).
ALLOWED_ORIGIN=https://cyberkiwi.app,capacitor://localhost,https://localhost

# Number of trusted reverse proxies in front of the server (0 = none)
TRUST_PROXY_HOPS=0

# Network bind address. Defaults to 127.0.0.1. Production refuses a non-loopback HOST unless ALLOWED_ORIGIN is set.
# HOST=127.0.0.1

# PostgreSQL connection for the Phase 1 ingestion store (see docker-compose.yml).
# A host other than localhost or 127.0.0.1 must request TLS, for example ...?sslmode=require
DATABASE_URL=postgresql://cyberkiwi:cyberkiwi@localhost:5433/cyberkiwi?schema=public

# Ingestion worker (npm run worker:ingest)
# WORKER_INTERVAL_MS=300000
# WORKER_CONCURRENCY=4

# Enrichment worker (npm run worker:enrich). Runs CVE/ATT&CK/entity jobs and the daily KEV and EPSS syncs.
# ENRICH_INTERVAL_MS=60000

# Push notifications. Without these, push is reported as unavailable (never as working).
# Android (FCM HTTP v1): paste the service account JSON on one line, or point to a file.
# FCM_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","project_id":"..."}
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json
# iOS (APNs token auth): key id, team id, bundle id and the .p8 key (\n escapes allowed).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.cyberkiwi.client
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_PRODUCTION=false

# Accounts (invite-only). Create the first invite and promote the first admin from the server machine:
#   npm run auth:invite -- --cohort beta-1
#   npm run auth:promote -- you@example.com

# Client build: CyberKiwi server base URL (empty = same origin; unset = local feed fetching).
# Set per environment. Never hard-code a production URL in the client.
# VITE_CYBERKIWI_API_BASE_URL=http://127.0.0.1:3000
