# Line endings: the repository stores LF. Checkouts on Windows used to arrive as CRLF and showed
# every file as modified on Linux; these rules keep the stored and checked-out forms consistent.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never converted or diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.mp3  binary
*.mp4  binary
*.wav  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.jar  binary
*.apk  binary
*.aab  binary
*.keystore binary
*.jks  binary
*.gz   binary
*.zip  binary
