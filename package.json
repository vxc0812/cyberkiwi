{
  "name": "cyberkiwi-client",
  "description": "CyberKiwi - Cybersecurity news intelligence client. Real-time threat intelligence, CVE alerts, vulnerability feeds, and AI-powered briefings.",
  "author": "CyberKiwi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.cjs",
    "test": "tsx tests/clustering.test.ts && tsx tests/opml.test.ts && tsx tests/readability.test.ts && tsx tests/netSafety.test.ts && tsx tests/ingestion-contract.test.ts && tsx tests/feed-policy.test.ts && tsx tests/client-api.test.ts && tsx tests/nvd-adapter.test.ts && tsx tests/load-env.test.ts && tsx tests/cybersec-blocks.test.ts && tsx tests/sanitize.test.ts && tsx tests/feed-parser.test.ts && tsx tests/external-url.test.ts && tsx tests/resource-limits.test.ts && tsx tests/network-address.test.ts && tsx tests/ai-guard.test.ts && tsx tests/cleanup.test.ts && tsx tests/ai-byok.test.ts && tsx tests/http-security.test.ts && tsx tests/read-api-auth.test.ts && tsx tests/server-read-gate.test.ts && tsx tests/enrichment-rules.test.ts && tsx tests/push-providers.test.ts && tsx tests/client-auth-keys.test.ts && tsx tests/push-rules.test.ts && tsx tests/app-links.test.ts",
    "make-icon": "node scripts/make-icon.js",
    "build:win": "npm run build && npm run make-icon && electron-builder --win",
    "publish:win": "npm run build && npm run make-icon && electron-builder --win --publish always",
    "desktop": "npm run build && electron .",
    "desktop:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "build:android": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "build:linux": "npm run build && npm run make-icon && electron-builder --linux --x64 --publish never",
    "publish:linux": "npm run build && npm run make-icon && electron-builder --linux --x64 --publish always",
    "test:desktop": "node --test tests/desktop-linux.test.cjs",
    "smoke:server": "node scripts/smoke-server.cjs",
    "test:auth-flow": "node scripts/auth-read-flow.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "worker:ingest": "tsx server/ingestion/run-worker.ts",
    "worker:once": "tsx server/ingestion/run-worker.ts --once",
    "db:seed": "tsx server/ingestion/seed.ts",
    "test:db": "node scripts/test-db.cjs",
    "release:check-api": "node scripts/require-api-url.cjs",
    "catalog:check": "tsx server/ingestion/catalogCheck.ts",
    "worker:enrich": "tsx server/enrichment/run-worker.ts",
    "worker:push": "tsx server/push/run-worker.ts",
    "auth:invite": "tsx server/auth/cli.ts invite",
    "auth:promote": "tsx server/auth/cli.ts promote"
  },
  "build": {
    "appId": "com.cyberkiwi.client",
    "productName": "CyberKiwi",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/**",
      "node_modules/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CyberKiwi"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cyberkiwi",
        "repo": "cyberkiwi-client"
      }
    ],
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "maintainer": "CyberKiwi <hello@cyberkiwi.app>",
      "desktop": {
        "entry": {
          "StartupWMClass": "CyberKiwi"
        }
      },
      "executableName": "cyberkiwi"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@google/genai": "^2.4.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "capacitor-secure-storage-plugin": "^0.14.2",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "isomorphic-dompurify": "4.6.0",
    "linkedom": "^0.18.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "prisma": "^7.10.1",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true,
    "electron@43.4.0": true
  }
}
